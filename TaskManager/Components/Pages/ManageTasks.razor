@page "/"
@using TaskManager.Models
@using TaskManager.Services
@inject TaskApiService TaskApi
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="d-flex justify-content-between align-items-center mb-5">
    <h1 class="fw-bold">Manage Tasks</h1>
    @if (tasks.Any())
    {
        <button class="btn btn-primary" @onclick="GoToCreate">+ Create New Task</button>
    }
</div>

@* Show an empty state message if no tasks exist, else show tasks table *@
@if (!tasks.Any())
{
    <div class="text-center py-5">
        <p class="fs-1">📋</p>
        <h5 class="text-muted mb-3">No tasks yet</h5>
        <p class="text-muted mb-4">Get started by creating your first task.</p>
        <button class="btn btn-primary" @onclick="GoToCreate">+ Create your first task</button>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 25%">Title</th>
                        <th style="width: 35%">Description</th>
                        <th style="width: 15%">Status</th>
                        <th style="width: 15%">Due Date</th>
                        <th style="width: 10%"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in tasks)
                    {
                        <tr class="@GetRowClass(task.Status)" style="cursor:pointer;" @onclick="() => GoToDetail(task.Id)">

                            <td>@task.Title</td>
                            <td>@(string.IsNullOrWhiteSpace(task.Description) ? "--" : task.Description)</td>
                            <td>
                                <select class="form-select form-select-sm" value="@task.Status" @onchange="async e => await ChangeStatus(task.Id, e.Value!.ToString()!)">
                                    <option value="Pending">Pending</option>
                                    <option value="InProgress">In Progress</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Cancelled">Cancelled</option>
                                </select>
                            </td>
                            <td>@(task.DueDate.HasValue ? task.DueDate.Value.ToString("dd/MM/yyyy") : "--")</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteTask(task.Id)" @onclick:stopPropagation="true">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<TaskItem> tasks = new List<TaskItem>();

    protected override async Task OnInitializedAsync()
    {
        tasks = await TaskApi.GetAllTasksAsync();
    }

    private async Task ChangeStatus(int taskId, string newStatus)
    {
        await TaskApi.UpdateTaskStatusAsync(taskId, newStatus);
        tasks = await TaskApi.GetAllTasksAsync();
    }

    private async Task DeleteTask(int taskId)
    {
        await TaskApi.DeleteTaskAsync(taskId);
        tasks = await TaskApi.GetAllTasksAsync();
    }

    private void GoToCreate()
    {
        Navigation.NavigateTo("/CreateTask");
    }

    private string GetRowClass(string status) => status switch
    {
        "Pending"    => "status-pending",
        "InProgress" => "status-inprogress",
        "Completed"  => "status-completed",
        "Cancelled"  => "status-cancelled",
        _            => ""
    };

    private void GoToDetail(int id) => Navigation.NavigateTo($"/tasks/{id}");

}
