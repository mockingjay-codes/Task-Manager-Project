@page "/manage-tasks"
@using TaskManager.Models
@using TaskManager.Services
@inject TaskApiService TaskApi
@rendermode InteractiveServer

<h1>Manage Tasks</h1>

<button class = "btn btn-primary mb-3" @onclick="ShowCreateForm">Create New Task</button>

@*Inline form visible when showCreateForm is true*@
@if (showCreateForm)
{
    <div class="card p-3 mb-3">
            <h5 class="card-title">Create New Task</h5>
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" id="title" class="form-control" @bind="newTask.Title" />
            </div>
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea id="description" class="form-control" @bind="newTask.Description"></textarea>
            </div>
            <div class="mb-3">
                <label for="dueDate" class="form-label">Due Date</label>
                <input type="date" id="dueDate" class="form-control" @bind="newTask.DueDate" />
            </div>
            <button class="btn btn-success" @onclick="CreateTask">Create</button>
            <button class="btn btn-secondary ms-2" @onclick="HideCreateForm">Cancel</button>
        </div>

}

@*Display Existing Tasks*@
<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Status</th>
            <th>Due Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var task in tasks)
        {
            <tr>
                <td>@task.Title</td>
                <td>@task.Description</td>
                <td>
                    @*Dropdown calls ChangeStatus when status selection changes*@
                    <select class="form-select form-select-sm" value="@task.Status" @onchange="async e => ChangeStatus(task.Id, e.Value!.ToString()!)">
                        <option>Pending</option>
                        <option >InProgress</option>
                        <option >Completed</option>
                        <option  >Cancelled</option>
                    </select>
                </td>
                <td>@task.DueDate</td>
                <td>
                    <button class="btn btn-sm btn-danger ms-2" @onclick="() => DeleteTask(task.Id)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code{
    private List<TaskItem> tasks = new List<TaskItem>();
    private bool showCreateForm = false;
    private TaskItem newTask = new TaskItem();

    // Fetch all tasks on page load
    protected override async Task OnInitializedAsync()
    {
        tasks = await TaskApi.GetAllTasksAsync();
    }

    private void ShowCreateForm()
    {
        showCreateForm = true;
    }

    private void HideCreateForm()
    {
        showCreateForm = false;
        newTask = new TaskItem(); 
    }

    private async Task CreateTask()
    {
        await TaskApi.CreateTaskAsync(newTask.Title, newTask.Description, newTask.DueDate);
        tasks = await TaskApi.GetAllTasksAsync();
        HideCreateForm();
    }

    private async Task ChangeStatus(int taskId, string newStatus)
    {
        await TaskApi.UpdateTaskStatusAsync(taskId, newStatus);
        tasks = await TaskApi.GetAllTasksAsync();
    }

    private async Task DeleteTask(int taskId)
    {
        await TaskApi.DeleteTaskAsync(taskId);
        tasks = await TaskApi.GetAllTasksAsync();
    }
}
