@page "/CreateTask"
@using TaskManager.Models
@using TaskManager.Services
@inject TaskApiService TaskApi
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer


<div class="d-flex justify-content-between align-items-center mb-5">
    <h1 class="mb-3">Create a new task</h1>
   <button class="btn btn-primary" @onclick="GoToHome">Return Home</button>
</div>


    <div class="card p-4 mb-4 mx-auto mt-5" style="max-width: 700px;">

            <div class="mb-4">
                <label for="title" class="form-label">Title<span class="text-danger">*</span></label>
                <input type="text" id="title" class="form-control" @bind="newTask.Title" />
            </div>
            <div class="mb-4">
                <label for="description" class="form-label">Description</label>
                <textarea id="description" class="form-control" @bind="newTask.Description"></textarea>
            </div>
            <div class="mb-4">
                <label for="dueDate" class="form-label">Due Date<span class="text-danger">*</span></label>
                <input @ref="dueDateRef" type="text" id="dueDate" class="form-control" @onchange="OnDueDateChange" placeholder="dd/mm/yyyy" />
            </div>
            <button class="btn btn-success" @onclick="CreateNewTask" disabled="@(string.IsNullOrWhiteSpace(newTask.Title) || !newTask.DueDate.HasValue)">Create</button>

        </div>

@* show success or error messages after task creation *@
    @if (successMessage is not null)
        {
            <div class="alert alert-success">@successMessage</div>
        }

    @if (errorMessage is not null)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }


@code{
    private TaskItem newTask = new TaskItem();
    private string? successMessage;
    private string? errorMessage;
    private ElementReference dueDateRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("initFlatpickr", dueDateRef, (object?)null);
    }

    private void OnDueDateChange(ChangeEventArgs e)
    {
        if (DateTime.TryParseExact(e.Value?.ToString(), "d/M/yyyy",
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var date))
            newTask.DueDate = date;
        else
            newTask.DueDate = null;
    }

    private async Task CreateNewTask()
    {
        successMessage = null;
        errorMessage = null;
        StateHasChanged(); 
        try
        {
            await TaskApi.CreateTaskAsync(newTask.Title, newTask.Description, newTask.DueDate);
            successMessage = "Task successfully created";
            // Reset form after submission
            newTask = new TaskItem();
            await JS.InvokeVoidAsync("clearFlatpickr", dueDateRef);
            StateHasChanged();
            await Task.Delay(700);
            GoToHome();

        }
        catch
        {
            errorMessage = "Failed to create task. Please try again shortly";
            StateHasChanged();
            await Task.Delay(2000);
            errorMessage = null;
        
        }
        
    }

    private void GoToHome()
    {
        Navigation.NavigateTo("/");
    }
}
